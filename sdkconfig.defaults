# Target is set by `idf.py set-target esp32p4` (do not hardcode here).
# ESP32-P4-Nano rev v1.3
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Flash / PSRAM (P4-Nano: 16MB flash, 32MB PSRAM in package)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000

# MQTT / Wi-Fi performance over ESP-Hosted SDIO
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# ESP-Hosted (P4 host + on-board C6). Pins default to Waveshare P4-Nano SDIO.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y

# App + LVGL need >1MB factory
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL 9
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_TABVIEW=y
CONFIG_LV_USE_BUTTONMATRIX=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_DEF_REFR_PERIOD=16

CONFIG_MQTT_PROTOCOL_311=y

# App defaults — WiFi comes from SoftAP/NVS (deye_cfg); leave SSID empty in production.
# CONFIG_DEYE_WIFI_SSID and CONFIG_DEYE_WIFI_PASSWORD intentionally unset.
CONFIG_DEYE_MQTT_HOST="192.168.3.249"
CONFIG_DEYE_MQTT_PORT=1883
CONFIG_DEYE_MQTT_BASE_TOPIC="iriv/ivt"
CONFIG_DEYE_STALE_TIMEOUT_S=30
CONFIG_DEYE_TZ="ICT-7"
CONFIG_DEYE_BACKLIGHT_PCT=80
CONFIG_DEYE_PANEL_H_RES=720
CONFIG_DEYE_PANEL_V_RES=1280
CONFIG_DEYE_DSI_LANES=2
